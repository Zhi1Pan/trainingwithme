{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u5bfc\u76f2\u72ac\u8bad\u7ec3\u5e08\uff1a\u4ece\u5b66\u4e60\u5230\u534f\u4f5c","text":"<p>\u4ece\u884c\u4e3a\u5b66\u4e60\u5230\u5b89\u5168\u534f\u4f5c\uff0c\u4f53\u9a8c\u52a8\u7269\u884c\u4e3a\u79d1\u5b66\u7684\u73b0\u5b9e\u5e94\u7528\u3002</p> <p>\u4f60\u5c06\u626e\u6f14\u4e00\u540d\u5bfc\u76f2\u72ac\u8bad\u7ec3\u5e08\uff0c\u5728\u4e09\u4e2a\u5173\u5361\u4e2d\u4f5c\u51fa\u8bad\u7ec3\u51b3\u7b56\uff0c\u89c2\u5bdf\u865a\u62df\u72ac\u300c\u4e1c\u4e1c\u300d\u7684\u5b66\u4e60\u8fc7\u7a0b\u3001\u60c5\u7eea\u4e0e\u8868\u73b0\uff0c\u7406\u89e3\u64cd\u4f5c\u6027\u6761\u4ef6\u4f5c\u7528\u3001\u884c\u4e3a\u5851\u9020\u3001\u523a\u6fc0\u8fa8\u522b\u4e0e\u6cdb\u5316\u7b49\u52a8\u7269\u884c\u4e3a\u79d1\u5b66\u7684\u6838\u5fc3\u6982\u5ff5\u3002</p> <p>\u5f00\u59cb\u8bad\u7ec3 \u67e5\u770b\u8bad\u7ec3\u603b\u7ed3</p>"},{"location":"#_2","title":"\u8bad\u7ec3\u65c5\u7a0b","text":"<p>\u4e09\u5f20\u5173\u5361\u5361\u7247\u4ece\u5de6\u5230\u53f3\u6784\u6210\u5b8c\u6574\u7684\u5b66\u4e60\u8def\u5f84\u3002\u70b9\u51fb\u5361\u7247\u5373\u53ef\u8fdb\u5165\u5bf9\u5e94\u5173\u5361\uff0c\u8bad\u7ec3\u8fdb\u5ea6\u4f1a\u81ea\u52a8\u4fdd\u5b58\u3002</p> \u79d1\u5b66\u8bf4\u660e\u4e0e\u5c40\u9650\uff1a\u8fd9\u4e2a\u6a21\u62df\u548c\u771f\u5b9e\u8bad\u7ec3\u5dee\u5728\u54ea\uff1f <ul> <li>\u6559\u5b66\u6027\u7b80\u5316\uff1a\u672c\u6a21\u62df\u628a\u300c\u64cd\u4f5c\u6027\u6761\u4ef6\u4f5c\u7528\u3001\u884c\u4e3a\u5851\u9020\u3001\u523a\u6fc0\u8fa8\u522b\u4e0e\u6cdb\u5316\u3001\u4eba\u72ac\u534f\u4f5c\u300d\u538b\u7f29\u8fdb\u4e09\u4e2a\u5173\u5361\u7684\u5c11\u6570\u51e0\u6b21\u51b3\u7b56\uff0c\u7528\u4e8e\u5e2e\u52a9\u7406\u89e3\u6982\u5ff5\uff0c\u4e0d\u7b49\u540c\u4e8e\u771f\u5b9e\u8bad\u7ec3\u6d41\u7a0b\u3002\u771f\u5b9e\u7684\u8bad\u7ec3\u51b3\u7b56\u8fdc\u4e0d\u6b62\u4e09\u4e2a\u9009\u9879\u3002</li> <li>\u771f\u5b9e\u8bad\u7ec3\u7684\u57fa\u7840\uff1a\u73b0\u4ee3\u5bfc\u76f2\u72ac\u8bad\u7ec3\u4ee5\u6b63\u5f3a\u5316\uff08R+\uff09\u548c LIMA\uff08\u6700\u5c11\u4fb5\u5165\u3001\u6700\u5c11\u538c\u6076\uff09\u539f\u5219\u4e3a\u4e3b\uff0c\u8bad\u7ec3\u5468\u671f\u4ee5\u5e74\u8ba1\u3001\u91cd\u590d\u6b21\u6570\u4ee5\u5343\u8ba1\uff0c\u5e76\u4e14\u5b58\u5728\u8f83\u9ad8\u7684\u6dd8\u6c70\u7387\u2014\u2014\u4e0d\u662f\u6bcf\u6761\u72ac\u90fd\u9002\u5408\u6210\u4e3a\u5bfc\u76f2\u72ac\u3002</li> <li>\u534f\u4f5c\u662f\u53cc\u5411\u7684\uff1a\u72ac\u63d0\u4f9b\u7269\u7406\u63d0\u793a\uff08\u5728\u53f0\u9636\u3001\u8def\u53e3\u524d\u505c\u6b65\uff0c\u8eab\u4f53\u504f\u5411\u7b49\uff09\uff0c\u4eba\u8d1f\u8d23\u7efc\u5408\u5224\u65ad\u4e0e\u51b3\u7b56\uff1b\u5bfc\u76f2\u72ac\u4e0d\u4f1a\u770b\u7ea2\u7eff\u706f\uff0c\u4e5f\u4e0d\u80fd\u72ec\u7acb\u5b8c\u6210\u6240\u6709\u4ea4\u901a\u5224\u65ad\u3002\u534f\u4f5c\u662f\u53cc\u5411\u540c\u6b65\uff0c\u800c\u4e0d\u662f\u5355\u5411\u6307\u4ee4\u3002</li> <li>\u798f\u5229\u6846\u67b6\uff1a\u8bc4\u4f30\u8bad\u7ec3\u65b9\u6848\u53ef\u91c7\u7528\u4e94\u57df\u6a21\u578b\uff08\u8425\u517b\u3001\u73af\u5883\u3001\u5065\u5eb7\u3001\u884c\u4e3a\u3001\u5fc3\u7406\u72b6\u6001\uff09\u7684\u89c6\u89d2\u3002\u8bad\u7ec3\u5e94\u662f\u6109\u5feb\u4e14\u81ea\u613f\u53c2\u4e0e\u7684\uff0c\u4e0d\u5e94\u4f9d\u8d56\u60e9\u7f5a\u4e0e\u75b2\u52b3\u3002\u8be6\u89c1\u300c\u53c2\u8003\u6587\u732e\u4e0e\u79d1\u5b66\u4f9d\u636e\u300d\u9875\u9762\uff08\u5efa\u8bbe\u4e2d\uff09\u3002</li> </ul>"},{"location":"level1/","title":"\u7b2c\u4e00\u5173 \u00b7 \u5b66\u4f1a\u505c\u4e0b","text":"<p>\u4e3b\u9898\uff1a\u5f3a\u5316\u5b66\u4e60 \u2014\u2014 \u6b63\u5f3a\u5316\u4e0e\u884c\u4e3a\u5851\u9020</p> <p>\u76ee\u6807\uff1a\u8ba9\u865a\u62df\u72ac\u300c\u4e1c\u4e1c\u300d\u5b66\u4f1a\u5728\u542c\u5230\u53e3\u4ee4\u300c\u505c\u300d\u65f6\u505c\u4e0b\u811a\u6b65\u3002\u4f60\u5c06\u56f4\u7ed5\u5956\u52b1\u65f6\u673a\u3001\u8bad\u7ec3\u6b65\u9aa4\u548c\u8bad\u7ec3\u5b89\u6392\u4f5c\u51fa\u51b3\u7b56\u3002\u8bf7\u8bb0\u4f4f\uff1a\u6240\u6709\u72ac\u53ea\u53cd\u5e94\u5747\u4e3a\u7a0b\u5e8f\u6a21\u62df\u3002</p> <p>\u672c\u5173\u6982\u5ff5\uff1a<code>\u64cd\u4f5c\u6027\u6761\u4ef6\u4f5c\u7528</code> <code>\u6b63\u5f3a\u5316</code> <code>\u884c\u4e3a\u5851\u9020</code> <code>\u5f3a\u5316\u65f6\u673a</code></p> <p>\u6a21\u62df\u58f0\u660e</p> <p>\u672c\u5173\u6240\u6709\u72ac\u53ea\u53cd\u5e94\u4e0e\u5206\u6570\u5747\u4e3a\u7a0b\u5e8f\u751f\u6210\u7684\u6a21\u62df\u7ed3\u679c\u3002</p>"},{"location":"level2/","title":"\u7b2c\u4e8c\u5173 \u00b7 \u9002\u5e94\u590d\u6742\u73af\u5883","text":"<p>\u4e3b\u9898\uff1a\u523a\u6fc0\u8fa8\u522b\u3001\u523a\u6fc0\u6cdb\u5316\u4e0e\u6e10\u8fdb\u9002\u5e94</p> <p>\u76ee\u6807\uff1a\u628a\u5df2\u7ecf\u5b66\u4f1a\u7684\u300c\u505c\u300d\u5e26\u8fdb\u8d8a\u6765\u8d8a\u590d\u6742\u7684\u73af\u5883\u3002\u4f60\u5c06\u51b3\u5b9a\u4f55\u65f6\u589e\u52a0\u96be\u5ea6\u3001\u662f\u5426\u91cd\u590d\u7ec3\u4e60\uff0c\u4ee5\u53ca\u5982\u4f55\u5224\u65ad\u4e1c\u4e1c\u662f\u5426\u9002\u5408\u8fdb\u5165\u4e0b\u4e00\u9636\u6bb5\u3002\u6240\u6709\u73af\u5883\u53cd\u5e94\u5747\u4e3a\u7a0b\u5e8f\u6a21\u62df\u3002</p> <p>\u672c\u5173\u6982\u5ff5\uff1a<code>\u523a\u6fc0\u8fa8\u522b</code> <code>\u523a\u6fc0\u6cdb\u5316</code> <code>\u6e10\u8fdb\u9002\u5e94</code> <code>\u884c\u4e3a\u6d88\u9000</code></p> <p>\u6a21\u62df\u58f0\u660e</p> <p>\u672c\u5173\u6240\u6709\u72ac\u53ea\u53cd\u5e94\u4e0e\u5206\u6570\u5747\u4e3a\u7a0b\u5e8f\u751f\u6210\u7684\u6a21\u62df\u7ed3\u679c\u3002</p>"},{"location":"level3/","title":"\u7b2c\u4e09\u5173 \u00b7 \u5b89\u5168\u4f18\u5148","text":"<p>\u4e3b\u9898\uff1a\u60c5\u5883\u5224\u65ad\u4e0e\u4eba\u72ac\u534f\u4f5c</p> <p>\u76ee\u6807\uff1a\u5728\u6a21\u62df\u60c5\u5883\u4e2d\u7ec3\u4e60\u300c\u4eba\u72ac\u534f\u4f5c\u300d\u7684\u5b89\u5168\u51b3\u7b56\u3002\u8bf7\u7262\u8bb0\uff1a\u672c\u5173\u53ea\u7528\u4e8e\u89e3\u91ca\u884c\u4e3a\u79d1\u5b66\u539f\u7406\uff0c\u4e0d\u662f\u771f\u5b9e\u7684\u5bfc\u76f2\u72ac\u8bad\u7ec3\u6559\u7a0b\uff1b\u5bfc\u76f2\u72ac\u4e0d\u80fd\u72ec\u7acb\u5b8c\u6210\u6240\u6709\u4ea4\u901a\u5224\u65ad\uff0c\u771f\u5b9e\u7684\u5b89\u5168\u8d23\u4efb\u5728\u4f7f\u7528\u8005\u3002</p> <p>\u672c\u5173\u6982\u5ff5\uff1a<code>\u4eba\u72ac\u534f\u4f5c</code> <code>\u52a8\u7269\u798f\u5229</code> <code>\u60c5\u5883\u5224\u65ad</code></p> <p>\u6a21\u62df\u58f0\u660e</p> <p>\u672c\u5173\u6240\u6709\u72ac\u53ea\u53cd\u5e94\u4e0e\u5206\u6570\u5747\u4e3a\u7a0b\u5e8f\u751f\u6210\u7684\u6a21\u62df\u7ed3\u679c\u3002</p>"},{"location":"summary/","title":"\u8bad\u7ec3\u603b\u7ed3","text":"<p>\u4ee5\u4e0b\u662f\u4f60\u5728\u4e09\u4e2a\u5173\u5361\u4e2d\u7684\u4e3b\u8981\u9009\u62e9\u4e0e\u6a21\u62df\u8868\u73b0\u6c47\u603b\u3002\u6240\u6709\u5206\u6570\u5747\u4e3a\u6559\u5b66\u6a21\u62df\u7ed3\u679c\u3002</p> <p>\u6a21\u62df\u58f0\u660e</p> <p>\u672c\u9875\u6240\u6709\u72ac\u53ea\u53cd\u5e94\u3001\u5206\u6570\u4e0e\u5206\u6790\u5747\u4e3a\u7a0b\u5e8f\u751f\u6210\u7684\u6a21\u62df\u7ed3\u679c\uff0c\u4e0d\u6784\u6210\u771f\u5b9e\u7684\u72ac\u7c7b\u5b9e\u9a8c\u6570\u636e\u6216\u8bad\u7ec3\u5efa\u8bae\u3002</p>"}]}